#!/usr/bin/env python3
import os
import sys
import time
import subprocess
import getpass

# Optional database driver check
try:
    import mysql.connector
    HAS_MYSQL = True
except ImportError:
    HAS_MYSQL = False

# Database Credentials
DB_HOST = "db.infrahost.internal"  # Change to your SQL Server IP/Domain
DB_USER = "infra_auth"
DB_PASS = "SecureAuthPassword123!"
DB_NAME = "infraos_licensing"

MARKER_FILE = "/etc/infraos/.setup_completed"

def clear():
    os.system('clear' if os.name == 'posix' else 'cls')

def banner():
    print("=" * 60)
    print("             WELCOME TO INFRAOS V1.0.0.0")
    print("            Enterprise Deployment Wizard")
    print("=" * 60)
    print()

def check_internet():
    print("[1/5] Checking network connectivity...")
    # Ping Cloudflare DNS to check active connection
    res = subprocess.run(["ping", "-c", "1", "1.1.1.1"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if res.returncode != 0:
        print("\n[ERROR] No active internet connection detected!")
        print("InfraOS requires an active network connection to contact the licensing database.")
        sys.exit(1)
    print("      -> Internet Connection: OK\n")

def validate_db_credentials(product_key, staff_id, staff_pin):
    print("\n[3/5] Connecting to InfraHost Authentication Database...")
    
    # If MySQL driver isn't installed during build, emulate/fallback or connect
    if not HAS_MYSQL:
        print("      -> [Demo Mode] Validating against simulated SQL endpoint...")
        time.sleep(2)
        # Mock validation check for testing
        if len(product_key) >= 10 and len(staff_pin) in [4, 5, 6]:
            return True
        return False

    try:
        conn = mysql.connector.connect(
            host=DB_HOST,
            user=DB_USER,
            password=DB_PASS,
            database=DB_NAME,
            connect_timeout=5
        )
        cursor = conn.cursor(dictionary=True)
        
        query = """
            SELECT * FROM deployments 
            WHERE product_key = %s AND staff_id = %s AND staff_pin = %s AND is_active = 1
        """
        cursor.execute(query, (product_key, staff_id, staff_pin))
        result = cursor.fetchone()
        
        cursor.close()
        conn.close()
        
        return result is not None

    except Exception as e:
        print(f"\n[ERROR] Database connection failed: {e}")
        return False

def main():
    if os.path.exists(MARKER_FILE):
        return

    clear()
    banner()

    # Step 1: Internet Gate
    check_internet()

    # Step 2: License & Staff Verification Input
    print("[2/5] Verification Credentials")
    product_key = input("  Enter Product Key (e.g., INFRA-2026-X99): ").strip()
    
    is_staff = input("  Is this deployment authorized by Staff? (y/n): ").strip().lower()
    staff_id = "N/A"
    staff_pin = "0000"

    if is_staff == 'y':
        staff_id = input("  Enter Staff ID: ").strip()
        while True:
            staff_pin = getpass.getpass("  Enter 4 to 6 digit Staff PIN: ").strip()
            if staff_pin.isdigit() and len(staff_pin) in [4, 5, 6]:
                break
            print("  [!] Invalid PIN format. Must be a 4, 5, or 6 digit number.")

    # Step 3: SQL Database Check
    if not validate_db_credentials(product_key, staff_id, staff_pin):
        print("\n[X] AUTHENTICATION FAILED!")
        print("    The Product Key or Staff authorization credentials were not recognized by the server.")
        sys.exit(1)

    print("      -> Credentials Authenticated Successfully!\n")

    # Step 4: System Hostname & Password Setup
    print("[4/5] System Configuration")
    sys_hostname = input("  Enter Server Hostname [Default: InfraHost]: ").strip()
    if not sys_hostname:
        sys_hostname = "InfraHost"
    
    subprocess.run(["hostnamectl", "set-hostname", sys_hostname])

    print("  Set Administrator (root) Password:")
    subprocess.run(["passwd"])

    # Step 5: Finalize and Lock Setup
    print("\n[5/5] Finalizing InfraOS Installation...")
    os.makedirs("/etc/infraos", exist_ok=True)
    with open(MARKER_FILE, "w") as f:
        f.write(f"ACTIVATED\nKey={product_key}\nStaff={staff_id}\nHost={sys_hostname}\n")

    print("\n" + "=" * 60)
    print("  InfraOS V1.0.0.0 Setup Complete! Launching Shell...")
    print("=" * 60 + "\n")
    time.sleep(2)

if __name__ == "__main__":
    main()
